@@ -0,0 +1,47 @@
+#!/bin/sh /etc/rc.common
+# SPDX-License-Identifier: GPL-2.0-only
+# Подтверждение слота для стокового MiWiFi U-Boot (Xiaomi BE10000).
+# Реализовано по документированному поведению флагов (docs/stock/board.md).
+START=99
+
+# Слот, с которого загружено ядро: пословный разбор cmdline.
+be10000_active_slot() {
+    local w
+    for w in $(cat /proc/cmdline); do
+        case "$w" in
+            ubi.mtd=rootfs)   printf '0'; return 0 ;;
+            ubi.mtd=rootfs_1) printf '1'; return 0 ;;
+        esac
+    done
+    return 1
+}
+
+# Пишем переменную только если значение изменилось (бережём env-раздел).
+be10000_env_set() {
+    local key="$1" val="$2"
+    [ "$(fw_printenv -n "$key" 2>/dev/null)" = "$val" ] && return 0
+    fw_setenv "$key" "$val" 2>/dev/null
+}
+
+start() {
+    # Тестовый образ остаётся одноразовой попыткой: сбой вернёт сток.
+    [ -e /rom/etc/be10000-test ] && {
+        logger -t be10000-boot "test image: слот не подтверждаем"
+        return 0
+    }
+    fw_printenv -n flag_boot_rootfs >/dev/null 2>&1 || {
+        logger -t be10000-boot "fw_printenv недоступен; проверьте /etc/fw_env.config"
+        return 0
+    }
+    local slot
+    slot="$(be10000_active_slot)" || {
+        logger -t be10000-boot "нет ubi.mtd=rootfs* в cmdline; флаги не трогаем"
+        return 0
+    }
+    be10000_env_set flag_last_success    "$slot"
+    be10000_env_set flag_boot_success    1
+    be10000_env_set flag_ota_reboot      0
+    be10000_env_set flag_try_sys1_failed 0
+    be10000_env_set flag_try_sys2_failed 0
+    logger -t be10000-boot "слот $slot подтверждён"
+}
diff --git a/target/linux/qualcommbe/ipq95xx/base-files/etc/init.d/be10000-bootlog b/target/linux/qualcommbe/ipq95xx/base-files/etc/init.d/be10000-bootlog
new file mode 100755
index 0000000000..efd3e775b2
--- /dev/null
+++ b/target/linux/qualcommbe/ipq95xx/base-files/etc/init.d/be10000-bootlog
@@ -0,0 +1,15 @@
+#!/bin/sh /etc/rc.common
+# SPDX-License-Identifier: GPL-2.0-only
+# Снимок журнала загрузки в раздел crash_syslog (чтение со стока: dd|strings).
+START=98
+boot() {
+    (
+        sleep 25
+        mtd=$(sed -n 's/^\(mtd[0-9]*\):.*"crash_syslog"$/\1/p' /proc/mtd)
+        [ -n "$mtd" ] || exit 0
+        dmesg > /tmp/be10000-bootlog.txt
+        ip -br addr >> /tmp/be10000-bootlog.txt 2>/dev/null
+        flash_erase "/dev/$mtd" 0 0 2>/dev/null
+        dd if=/tmp/be10000-bootlog.txt of="/dev/$mtd" bs=2048 conv=sync 2>/dev/null
+    ) &
+}
