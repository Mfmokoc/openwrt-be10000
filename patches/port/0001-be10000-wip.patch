diff --git a/target/linux/qualcommbe/files/arch/arm64/boot/dts/qcom/ipq9574-common-wifi-pci.dtsi b/target/linux/qualcommbe/files/arch/arm64/boot/dts/qcom/ipq9574-common-wifi-pci.dtsi
